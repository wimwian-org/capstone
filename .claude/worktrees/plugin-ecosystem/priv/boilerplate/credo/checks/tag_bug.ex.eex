defmodule <%= @module %>.Credo.Check.Design.TagBUG do
  # Assembled at compile time so this file never contains the literal it looks
  # for. `credo/` is outside the analysed paths today, but a check that would
  # report itself the moment someone widened `included:` is a trap worth not
  # setting.
  @tag_name "B" <> "UG"

  @moduledoc """
  Flags a `#{@tag_name}` tag left in a comment.

  Credo ships `TagTODO` and `TagFIXME` but no equivalent for the rest of the
  tag vocabulary this project uses. See `.claude/10-comment-tags.md` for the
  full set and which of them block a build.

  `#{@tag_name}` marks a defect that is known and unfixed. It is red in the
  editor and blocking here for the same reason: shipping a recorded defect
  without either fixing it or converting it into a tracked issue is how a known
  bug becomes an unknown one.
  """

  use Credo.Check,
    base_priority: :high,
    category: :design,
    exit_status: 2,
    param_defaults: [include_doc: true],
    explanations: [
      check: @moduledoc,
      params: [include_doc: "Set to `true` to also include tags from @doc attributes."]
    ]

  alias Credo.Check.Design.TagHelper

  @doc false
  @impl true
  def run(%SourceFile{} = source_file, params) do
    issue_meta = IssueMeta.for(source_file, params)
    include_doc? = Params.get(params, :include_doc, __MODULE__)

    source_file
    |> TagHelper.tags(@tag_name, include_doc?)
    |> Enum.map(&issue_for(issue_meta, &1))
  end

  defp issue_for(issue_meta, {line_no, _line, trigger}) do
    format_issue(issue_meta,
      message: "Found a #{@tag_name} tag in a comment: #{trigger}",
      trigger: trigger,
      line_no: line_no
    )
  end
end
