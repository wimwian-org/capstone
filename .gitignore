# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
capstone-*.tar

# Scratch workspace for the subagent-driven-development skill (ledgers,
# dispatch briefs, review packages) — never part of the shipped package.
/.superpowers/

# Local secrets — GITHUB_TOKEN, HEX_API_KEY, etc. Never committed.
.env
.env.*

# Nested git worktree checkouts (used for isolated feature-branch work).
# Each one is its own separate checkout of this same repo — never a
# subdirectory's worth of content this repo should track.
/.claude/worktrees/

# Plugin archives are downloaded on demand from this repo's GitHub
# releases (see Capstone.Plugin.Remote) into an OS user-cache directory,
# never committed to source — see Capstone.Plugin.Registry.default_dir/0.
# A locally-packaged archive (mix capstone.plugin.package) lands here too;
# it gets attached to a release manually, not committed.
/priv/plugins/*.tar.gz

