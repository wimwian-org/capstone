# Sobelow config. Run from inside this app, never from the umbrella root --
# sobelow refuses an umbrella and asks for each app to be scanned separately.
#
# `router: nil` because there is no Phoenix router here yet. When a web app
# gains one, point this at it (e.g. "lib/capstone_web/router.ex") so the
# route-based checks can run at all.
[
  exit: :low,
  format: "txt",
  ignore: [],
  ignore_files: [],
  out: nil,
  private: false,
  router: nil,
  skip: false,
  threshold: :low,
  verbose: false
]
