# What this project asked for.
#
# Hand-authored and committed. Capstone writes it once at generation and never
# rewrites it -- it is a `:seed` file, owned by you from the moment it exists.
# Edit it and re-run `mix capstone.gen` to change what the project has.
#
# Its counterpart is `plugin.exs`, which Capstone generates and owns. This file
# records intent; that one records what was actually applied, at which version,
# with a content hash per file. Comparing the two is how an update tells an
# untouched file from one you have edited -- so never hand-edit `plugin.exs`.
#
# Read as data, never evaluated: this file is parsed as a literal, so opening a
# project's configuration cannot run its code.
%{
  schema_version: 1,
  base: <%= cond do %><% @api? -> %>:api<% @web? -> %>:web<% true -> %>:otp<% end %>,
  project: [
    name: "<%= @app %>",
    module: <%= @module %>,
    app: :<%= @app %>,
    github_org: "<%= @github_org %>"
  ],

  # Required, and `[]` is the only legal value in schema_version 1 --
  # `Capstone.Config` rejects the file outright without this key.
  plugins: []

  # Sections are added here as the project gains them. Each one is validated by
  # the matching `Capstone.Config.*` module:
  #
  #   api          assets       authn        cache        container
  #   features     otp          security     supervision  web
  #
  # For example:
  #
  #   features: [cqrs: true],
  #   authn: [local: true, oidc: false, saml: false],
  #   container: [runtime: :podman]
}
