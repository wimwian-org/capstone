# pnpm's installed packages — reinstalled from assets/pnpm-lock.yaml via
# "mix assets.setup".
assets/node_modules/

# Vite's hashed JS/CSS bundles and its build manifest — regenerated by
# "mix assets.build"/"mix assets.deploy".
priv/static/assets/
priv/static/.vite/

# Vitest coverage output ("mix assets.test.coverage").
assets/coverage/

# Playwright's own output ("mix assets.test.e2e").
playwright-report/
test-results/

