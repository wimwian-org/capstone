
  # nginx -- the only way to reach the app. Reverse-proxies the Phoenix
  # endpoints only (never the other sidecars): /api, the OpenAPI spec at
  # /openapi, and its Swagger UI at /docs. Takes over the app's own former
  # host port, so nothing external-facing changes for anyone already using
  # this project.
  nginx:
    image: docker.io/library/nginx:alpine
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    ports:
      - "${APP_PORT:-4000}:80"
    depends_on:
      - app
