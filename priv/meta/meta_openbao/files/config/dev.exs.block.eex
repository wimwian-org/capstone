
# Configure the OpenBao (Vault-compatible) secrets sidecar. Same fixed
# dev-mode token compose.yaml's openbao service is seeded with.
config :<%= @app %>, <%= @module %>.Vault,
  base_url: System.get_env("OPENBAO_ADDR", "http://localhost:8200"),
  token: System.get_env("OPENBAO_TOKEN", "<%= @app %>-dev-root-token")
